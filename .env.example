# Server-only contact-form delivery. Do not commit real credentials.
RESEND_API_KEY=
CONTACT_SENDER=contact@ceratosystems.com
CONTACT_RECIPIENT=andrija@ceratosystems.com

# Local shipment demo settings. Use a privately generated JWT secret and local PostgreSQL credentials.
DATABASE_URL=postgresql+psycopg://cerato_demo:choose-a-local-password@127.0.0.1:5432/cerato_demo
JWT_SECRET=replace-with-a-long-random-secret
COOKIE_SECURE=false
# Leave empty locally. Set to .ceratosystems.com in production to share login across subdomains.
COOKIE_DOMAIN=
APP_ENV=development
FRONTEND_ORIGIN=http://localhost:3000
APP_PUBLIC_URL=http://localhost:3000/demo1

# Required only when enabling customer email delivery through Cerato-controlled SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=andria@ceratosystems.com
